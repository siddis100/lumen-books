# =====================================================================
# Lumen Books — environment variables
# Copy to `.env.local` (local dev) and add the same keys in
# Netlify → Project configuration → Environment variables.
# NEVER commit `.env.local`.
# =====================================================================

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
# No trailing slash. Used for metadata, sitemap, hreflang and PayPal redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard → your project
#   Project Settings → API
#   Project Settings → Data  (Connection string / "URI")
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...            # "anon" public key (safe in the browser)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co            # server-side alias, same value
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...                # "service_role" — SERVER ONLY

# Database connection used by Drizzle.
# Use the *session* pooler (port 5432) for migrations and the *transaction*
# pooler (port 6543) for the app — both are IPv4-friendly, which Netlify needs.
# Password must be URL-encoded if it contains special characters.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Comma-separated list of e-mail addresses granted the admin role on first login.
ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------
# PayPal — https://developer.paypal.com/dashboard/applications
#   Sandbox app  → Sandbox keys   (test cards, no real money)
#   Live app     → Live keys      (after the account is verified)
# ---------------------------------------------------------------------
PAYPAL_ENV=sandbox                                   # sandbox | live
PAYPAL_CLIENT_ID=AYxxxxxxxxxxxxxxxx                   # matches NEXT_PUBLIC_PAYPAL_CLIENT_ID below
PAYPAL_CLIENT_SECRET=EXxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_CLIENT_ID=                          # same value as PAYPAL_CLIENT_ID
NEXT_PUBLIC_PAYPAL_ENV=sandbox

# Webhook ID created on the app (webhooks page). Required to verify
# PAYMENT.CAPTURE.COMPLETED signatures — never ship without it in production.
PAYPAL_WEBHOOK_ID=8UQxxxxxxxxxx

# ---------------------------------------------------------------------
# Resend — https://resend.com/api-keys  (free: 3 000 emails / month)
# ---------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Lumen Books <orders@yourdomain.com>"     # must be a verified Resend domain/sender
CONTACT_EMAIL=support@yourdomain.com

# ---------------------------------------------------------------------
# Seller identity — rendered in the legal pages (/legal/*)
# ---------------------------------------------------------------------
# Every field is optional: an empty one is simply not shown. But an address
# and a governing law are legally required before taking real payments.
# SELLER_ADDRESS accepts several lines separated by "\n" — in a .env file
# write them on one line: SELLER_ADDRESS=12 rue Exemple\n75000 Paris
SELLER_NAME=Lumen Books                                # trade name
SELLER_LEGAL_NAME=                                     # registered name, if different
SELLER_KIND=individual                                 # individual | company
SELLER_ADDRESS=                                        # postal address, "\n"-separated
SELLER_VAT=                                            # VAT / tax number
SELLER_REGISTRY=                                       # company registration number
SELLER_COUNTRY=Algeria                                   # country of registration
SELLER_GOVERNING_LAW=                                    # e.g. "French law" / "droit français"

# PayPal and this country do not mix, and `npm run env:check` says so out loud.
# PayPal does not open merchant accounts in Algeria, so:
#   - the account receiving the money has to be registered elsewhere, which
#     means the legal seller on these pages and the PayPal account will not
#     be the same entity;
#   - buyers in Algeria cannot pay from a PayPal balance, only from a card
#     in guest checkout, and PayPal may still refuse it;
#   - for that audience, treat CIB / Edahabia or BaridiMob as the primary
#     channel and PayPal as the secondary one.
# Leave SELLER_ADDRESS and SELLER_GOVERNING_LAW empty until you know them:
# an empty field is simply not rendered, an invented one is a lie.

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
# Shared secret protecting the maintenance endpoint (`/api/cron/expire-links`).
# Also used to sign guest download links when DOWNLOAD_LINK_SECRET is unset.
CRON_SECRET=change-me-to-a-long-random-string

# Dedicated secret for the guest download links (recommended: different from
# CRON_SECRET so rotating one does not break the other).
DOWNLOAD_LINK_SECRET=change-me-to-another-long-random-string